{% set private_app = lookup('file', private_app_manifest_path) | from_yaml %}
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: cluster-apps
  namespace: argocd
  finalizers:
  - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source:
    repoURL: https://github.com/TomeuUris/k3s-gitops.git
    targetRevision: main
    path: apps
    helm:
      values: |
{{ private_app['spec']['source']['helm']['values'] | indent(8, true) }}
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true