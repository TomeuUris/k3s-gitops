apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: cluster-apps
  namespace: argocd
  finalizers:
  - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source:
    repoURL: "{{ public_repo_url }}"
    targetRevision: "{{ public_repo_revision | default('main') }}"
    path: apps
    helm:
      values: |
          global:
            public_repo_url: {{ public_repo_url }}
            private_repo_url: {{ private_repo_url }}
            public_repo_revision: {{ public_repo_revision | default('main') }}
            private_repo_revision: {{ private_repo_revision | default('main') }}
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true